{
  "name": "anna-brew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node --watch backend/server.js",
    "dev:backend": "node --watch backend/server.js",
    "setup": "node backend/scripts/setup.js",
    "set-password": "node backend/scripts/set-password.js",
    "build": "next build",
    "start": "concurrently -k -n WEB,API \"next start\" \"node backend/server.js\"",
    "start:backend": "node backend/server.js",
    "lint": "oxlint",
    "preview": "next start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0"
  }
}
